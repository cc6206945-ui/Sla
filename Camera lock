local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end
local Camera = workspace.CurrentCamera

-- CONFIGURAÇÕES AVANÇADAS DO CAMLOCK & ANTI-SIDE DASH
local CONFIG = {
    MaxDistance = 500,               -- Alcance máximo do lock (Studs)
    TargetPart = "HumanoidRootPart", -- Parte principal do alvo
    BasePrediction = 0.138,          -- Predição base de movimento
    
    -- ANTI-SIDE DASH
    DashSensitivityThreshold = 18,   -- Velocidade lateral para detectar dash
    DashPredictionMultiplier = 2.1,  -- Multiplicador para travar no dash
    SmoothLerpFactor = 0.45,         -- Suavização do movimento
    
    WallCheck = false                -- Se true, ignora alvos atrás de paredes
}

-- ESTADOS INTERNOS
local LockActive = false
local CurrentTargetPart = nil
local CurrentTargetModel = nil
local SmoothedPredictedPos = nil

-- CRIAÇÃO DA INTERFACE (PLAYERGUI)
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("RGBOnlyCamlockUI")
if oldGui then oldGui:Destroy() end

local screenGui = Instance.new("ScreenGui")
